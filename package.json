{
  "name": "flipper-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI agent that controls a Flipper Zero from your phone, over Bluetooth or USB.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "teste:usb": "tsx scripts/teste-usb.ts",
    "teste:ferramentas": "tsx scripts/teste-ferramentas.ts",
    "teste:cabo": "tsx scripts/teste-cabo.ts",
    "teste:bastao": "tsx scripts/teste-bastao.ts",
    "teste:rpc-gpio": "tsx scripts/teste-rpc-gpio.ts"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.4",
    "serialport": "^12.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
