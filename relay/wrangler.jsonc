{
  // Worker do relay: OAuth (login do Claude) + endpoint MCP + um Durable Object por aparelho.
  "name": "flipper-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: exigido pela biblioteca de OAuth para buscar documentos de cliente (CIMD).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [
    // Criado com `npx wrangler kv namespace create OAUTH_KV`.
    { "binding": "OAUTH_KV", "id": "ffdf76bd18a8476bad2cac847ebb0023" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DEVICE", "class_name": "Device" }]
  },
  // Limites de chamadas de ferramenta (por aparelho e do servidor inteiro). No seu próprio relay,
  // ajuste à vontade: o plano grátis da Cloudflare aguenta cerca de 100 mil requisições por dia.
  "vars": { "LIMIT_PER_HOUR": "200", "LIMIT_PER_DAY": "1000", "GLOBAL_PER_DAY": "20000" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Device"] }],
  "observability": { "enabled": true }
}
